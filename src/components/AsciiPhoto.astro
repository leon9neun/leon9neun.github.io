---
/**
 * Photo made of characters, drawn on a canvas with a slow grain (see docs Funktionen).
 * Needs JavaScript, without it nothing is shown. With prefers-reduced-motion it is drawn once.
 * @prop {string} src - image in public/, e.g. "/images/bonn_map.jpg"
 * @prop {string} alt - description of the image
 * @prop {'light' | 'dark'} [variant='light'] - 'dark' is for Aubergine Black (light characters)
 */
const { src, alt, variant = 'light' } = Astro.props;
---

<figure class="ascii-photo" data-variant={variant}>
  <canvas class="photo-canvas" data-component="ascii-photo" data-src={src} role="img" aria-label={alt}
  ></canvas>
</figure>

<style>
  .ascii-photo {
    width: 100%;
    margin: 0;
  }

  /* The characters take these two colors (read by the script). */
  .ascii-photo[data-variant='light'] {
    --ascii-ink: var(--color-ink-black);
    --ascii-ink-dim: var(--color-dim);
  }

  .ascii-photo[data-variant='dark'] {
    --ascii-ink: var(--color-bone);
    --ascii-ink-dim: var(--color-dim);
  }

  .photo-canvas {
    display: block;
    max-width: 100%;
  }
</style>

<script>
  import { initPhoto } from '@lib/photo.js';
  import { prefersReducedMotion } from '@lib/motion.js';

  function initAsciiPhoto(root) {
    try {
      initPhoto(root, { src: root.dataset.src, isStatic: prefersReducedMotion() });
    } catch (error) {
      if (import.meta.env.DEV) console.error(error);
    }
  }

  document.querySelectorAll('[data-component="ascii-photo"]').forEach(initAsciiPhoto);
</script>
