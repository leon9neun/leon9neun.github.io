---
import { PROJECTS_PAGE } from '@lib/site.js';

import Button from '@components/Button.astro';
import RollingTitle from '@components/RollingTitle.astro';
import Tag from '@components/Tag.astro';

/**
 * Header and links of a project detail page. The Markdown body goes into the slot.
 * @prop {object} project - entry from the "projects" collection
 */
const { project } = Astro.props;
const { title, category, technologies, repo, live } = project.data;
---

<article class="project-detail">
  <header class="detail-header">
    <Tag variant="category">{category}</Tag>
    <RollingTitle>{title}</RollingTitle>
    <ul class="detail-technologies">
      {
        technologies.map((technology) => (
          <li>
            <Tag variant="technology">{technology}</Tag>
          </li>
        ))
      }
    </ul>
    <div class="detail-links">
      <Button href={repo} target="_blank" rel="noopener noreferrer">{PROJECTS_PAGE.visit}</Button>
      {
        live && (
          <Button href={live} variant="square" target="_blank" rel="noopener noreferrer">
            {PROJECTS_PAGE.live}
          </Button>
        )
      }
    </div>
  </header>

  <div class="prose">
    <slot />
  </div>

  <a class="detail-back" href="/projects">{PROJECTS_PAGE.back}</a>
</article>

<style>
  .project-detail {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .detail-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-16);
  }

  .detail-technologies,
  .detail-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--element-gap);
  }

  .detail-links {
    gap: var(--spacing-16);
  }

  .detail-back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
