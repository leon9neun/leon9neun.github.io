---
import { PROJECTS_PAGE } from '@lib/site.js';

import Button from '@components/Button.astro';
import Tag from '@components/Tag.astro';

/**
 * Project card. A click on the card opens it in place and shows the slot content
 * (the Markdown body), another click closes it. Without JavaScript the title is a link
 * to the detail page.
 * @prop {object} project - entry from the "projects" collection
 */
const { project } = Astro.props;
const { title, category, description, image, imageAlt, technologies, repo } = project.data;
const hasImage = Boolean(image);
const detailId = `detail-${project.id}`;
---

<article
  class="project-card"
  data-component="project-card"
  data-state="collapsed"
  data-variant={hasImage ? 'with-image' : 'text-only'}
>
  {hasImage && <img src={image} alt={imageAlt ?? ''} width="800" height="500" loading="lazy" />}
  <Tag variant="category">{category}</Tag>
  <h3 class="card-title">
    <a class="card-link" href={`/projects/${project.id}`} data-card-fallback>{title}</a>
    <button
      class="card-toggle"
      type="button"
      hidden
      aria-expanded="false"
      aria-controls={detailId}
      data-card-toggle>{title}</button
    >
  </h3>
  <p class="card-description">{description}</p>
  <div id={detailId} class="card-detail prose">
    <slot />
  </div>
  <ul class="card-technologies">
    {
      technologies.map((technology) => (
        <li>
          <Tag variant="technology">{technology}</Tag>
        </li>
      ))
    }
  </ul>
  <div class="card-actions">
    <Button href={repo} target="_blank" rel="noopener noreferrer">
      {PROJECTS_PAGE.visit}<span class="visually-hidden"> {title}</span>
    </Button>
  </div>
</article>

<style>
  /* The card is Parchment and sits on the dark band of the page, so the text is dark
     and the ring around the card is white. */
  .project-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-16);
    height: 100%;
    padding: var(--card-padding);
    border: 1px solid var(--color-bone);
    border-radius: var(--radius-cards);
    background: var(--color-parchment);
    color: var(--color-ink-black);
    scroll-margin-top: var(--spacing-24);
    transition: transform 0.2s ease;
  }

  .project-card[data-interactive] {
    cursor: pointer;
  }

  /* Lift and a ring around the card, drawn outside so it shows against the band. */
  @media (hover: hover) {
    .project-card:hover {
      transform: translateY(calc(-1 * var(--element-gap)));
      outline: 2px solid var(--color-pure-white);
    }
  }

  .project-card:has(:focus-visible) {
    outline: 2px solid var(--color-pure-white);
  }

  /* DarkSection makes every focus ring white. Inside the light card it must be dark again. */
  .project-card[data-state] :global(:focus-visible) {
    outline-color: var(--color-ink-black);
  }

  .project-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-cards);
  }

  .card-link,
  .card-toggle {
    color: inherit;
    text-decoration: none;
  }

  .card-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: inherit;
  }

  .card-toggle[hidden] {
    display: none;
  }

  .card-description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    flex: 1;
    font-size: var(--text-body-sm);
    line-height: var(--leading-body-sm);
    color: var(--color-dim);
  }

  .card-detail {
    display: none;
  }

  .card-detail :global(li)::before {
    color: var(--color-dim);
  }

  .project-card[data-state='expanded'] .card-description {
    display: block;
    flex: none;
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
  }

  .project-card[data-state='expanded'] .card-detail {
    display: flex;
    margin-block: var(--spacing-16);
  }

  .card-technologies,
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--element-gap);
  }

  .card-actions {
    align-items: center;
    gap: var(--spacing-16);
  }
</style>

<script>
  import { prefersReducedMotion } from '@lib/motion.js';

  const OPEN_EVENT = 'project-card:open';

  function initProjectCard(root) {
    const toggle = root.querySelector('[data-card-toggle]');
    const fallback = root.querySelector('[data-card-fallback]');
    if (!toggle || !fallback) return;

    fallback.hidden = true;
    toggle.hidden = false;
    root.dataset.interactive = '';

    root.addEventListener('click', handleClick);
    document.addEventListener(OPEN_EVENT, handleOtherOpened);

    function handleClick(event) {
      // links (Visit) work as usual, selecting text must not close the card
      if (event.target.closest('a')) return;
      if (window.getSelection()?.toString()) return;

      if (root.dataset.state === 'expanded') {
        setExpanded(false);
        return;
      }
      document.dispatchEvent(new CustomEvent(OPEN_EVENT, { detail: root }));
      setExpanded(true);
      // wait for the grid to move the card to the top
      requestAnimationFrame(() =>
        root.scrollIntoView({ block: 'start', behavior: prefersReducedMotion() ? 'auto' : 'smooth' }),
      );
    }

    function handleOtherOpened(event) {
      if (event.detail !== root) setExpanded(false);
    }

    function setExpanded(isExpanded) {
      root.dataset.state = isExpanded ? 'expanded' : 'collapsed';
      toggle.setAttribute('aria-expanded', String(isExpanded));
    }
  }

  document.querySelectorAll('[data-component="project-card"]').forEach(initProjectCard);
</script>
