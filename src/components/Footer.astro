---
import { SITE, NAV, LEGAL_NAV } from '@lib/site.js';

import ContactLinks from '@components/ContactLinks.astro';
import CopyEmail from '@components/CopyEmail.astro';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-about">
      <p class="footer-name">{SITE.name}</p>
      <p>{SITE.established}</p>
      <p>{SITE.techNote}</p>
    </div>

    <nav aria-label="Seitenübersicht">
      <ul class="footer-pages">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-contact">
      <CopyEmail />
      <ContactLinks variant="compact" />
    </div>
  </div>

  <div class="container footer-legal">
    <nav aria-label="Rechtliches">
      <ul>
        {
          LEGAL_NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--color-bone);
    padding-block: var(--spacing-48) var(--spacing-24);
    color: var(--color-dim);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body-sm);
  }

  .footer-grid {
    display: grid;
    gap: var(--spacing-32);
  }

  .footer-about {
    display: grid;
    gap: var(--element-gap);
  }

  .footer-name {
    color: var(--color-ink-black);
    font-weight: var(--font-weight-bold);
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-ink-black);
    text-decoration: underline;
  }

  .footer-contact {
    display: grid;
    justify-items: start;
    gap: var(--element-gap);
  }

  .footer-legal {
    margin-top: var(--spacing-32);
    font-size: var(--text-caption);
  }

  .footer-legal ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--spacing-24);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
